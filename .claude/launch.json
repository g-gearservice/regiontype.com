{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "regiontype",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec python3 -m http.server \"$PORT\""],
      "autoPort": true
    },
    {
      "name": "regiontype-cf",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec npx wrangler dev --port \"$PORT\" --persist-to \"${TMPDIR:-/tmp}/regiontype-wrangler\""],
      "autoPort": true
    }
  ]
}
