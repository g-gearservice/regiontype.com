/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests

https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

# 계정 화면의 '카메라로 따라 하기' 한 곳에서만 카메라를 연다. 위의 전역 규칙은
# camera=() 그대로다 — 나머지 화면은 물어볼 길조차 없다. 켤 때 브라우저가 사람에게
# 다시 묻고, 영상은 이 기기 안에서만 돈다(assets/face/mimic.js).
/account/*
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

# signin/index.html 은 해시를 그대로 홈에 넘기고 비키는 인라인 스크립트 한 줄이
# 전부다 — script-src 'self' 만으로는 그 한 줄이 막혀 SSO 착지가 끊긴다.
# ★ 그 스크립트를 고치면 이 해시도 같이 고친다(위 welcome 쪽 명령과 같다).
/signin/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-IOZZwNG3ZxNT7PetmyyXjdIuCI0F7ZJccADptiF+bRE='; style-src 'self'; img-src 'self' data:; connect-src 'self' https://g.gearservicevanguard.com; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/settings/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://g.gearservicevanguard.com; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# 가입 안내. 자기 파일과 중계기 말고는 아무 데도 닿지 않는다.
# script-src 의 sha256 은 index.html 맨 위 인라인 부트스트랩(야간 테마·모션)의
# 해시다. 그 한 줄은 스타일시트보다 먼저 돌아야 흰 화면이 번쩍이지 않으므로
# 인라인으로 둔다 — 'unsafe-inline' 을 열지 않고 그 스크립트 하나만 허락한다.
# ★ 그 인라인 스크립트를 한 글자라도 고치면 이 해시도 같이 고쳐야 한다.
#   python3 -c "import base64,hashlib,re;h=re.search(r'<script>(.*?)</script>',open('welcome/index.html').read(),re.S).group(1);print('sha256-'+base64.b64encode(hashlib.sha256(h.encode()).digest()).decode())"
/welcome/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-wyy+Y5yhHKyQy2z78TtRRG7+bKKUyGoOjTrLQjOxbus='; style-src 'self'; img-src 'self' data:; connect-src 'self' https://g.gearservicevanguard.com; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
